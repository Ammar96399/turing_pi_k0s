---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: linear-program
  namespace: lp-schedules
spec:
  replicas: 1
  selector:
    matchLabels:
      app: linear-program
  template:
    metadata:
      labels:
        app: linear-program
    spec:
      nodeSelector:
        role: server
      containers:
      - name: linear-program
        image: docker.io/library/linear-program:local
        imagePullPolicy: Never
        ports:
        - containerPort: 49090
          name: http
        resources:
          requests:
            memory: "256Mi"
            cpu: "50m"
          limits:
            memory: "512Mi"
            cpu: "500m"
        livenessProbe:
          httpGet:
            path: /docs
            port: 49090
          initialDelaySeconds: 10
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /docs
            port: 49090
          initialDelaySeconds: 5
          periodSeconds: 5

---
apiVersion: v1
kind: Service
metadata:
  name: linear-program
  namespace: lp-schedules
spec:
  type: NodePort
  selector:
    app: linear-program
  ports:
  - port: 49090
    targetPort: 49090
    nodePort: 30049
    name: http

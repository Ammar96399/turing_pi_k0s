---
server:
  persistentVolume:
    enabled: false
  resources:
    requests:
      memory: "128Mi"
      cpu: "100m"
    limits:
      memory: "256Mi"
      cpu: "500m"
  service:
    type: NodePort
    port: 9090
    nodePort: 30090
  global:
    scrape_interval: "7500ms"
    evaluation_interval: "6s"
    scrape_timeout: "6s"
  nodeSelector:
    model: cm4

prometheus:
  prometheusSpec:
    scrape_interval: "7500ms"
    evaluation_interval: "6s"
    scrape_timeout: "6s"

nodeExporter:
  enabled: true
  resources:
    requests:
      memory: "32Mi"
      cpu: "50m"
    limits:
      memory: "64Mi"
      cpu: "200m"

alertmanager:
  enabled: false
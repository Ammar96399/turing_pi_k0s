---
server:
  persistentVolume:
    enabled: false
  resources:
    requests:
      memory: "512Mi"
      cpu: "100m"
    limits:
      memory: "1024Mi"
      cpu: "500m"
  service:
    type: NodePort
    port: 9090
    nodePort: 30090
  global:
    scrape_interval: "{{ scrape_interval }}s"
    evaluation_interval: "{{ scrape_interval }}s"
    scrape_timeout: "{{ scrape_interval }}s"
  nodeSelector:
    role: server

prometheus:
  prometheusSpec:
    scrape_interval: "{{ scrape_interval }}s"
    evaluation_interval: "{{ scrape_interval }}s"
    scrape_timeout: "{{ scrape_interval }}s"

nodeExporter:
  enabled: true
  resources:
    requests:
      memory: "32Mi"
      cpu: "50m"
    limits:
      memory: "64Mi"
      cpu: "200m"

alertmanager:
  enabled: false